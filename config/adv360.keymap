#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_TOG";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    macros {
        seasame: seasame {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LS(S) &kp E &kp A &kp S &kp A &kp M &kp E>;
            label = "SEASAME";
        };

        email1: email1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp E &kp M &kp A &kp I &kp L &kp AT &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
            label = "EMAIL1";
        };

        email2: email2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp E &kp M &kp A &kp I &kp L &kp AT &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
            label = "EMAIL2";
        };

        username1: username1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp K &kp H &kp A &kp R &kp O &kp U &kp T &kp I &kp N &kp I &kp A &kp N>;
            label = "USERNAME1";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL    &kp N1     &kp N2     &kp N3    &kp N4     &kp N5  &mo_tog 3 1                                                     &mo_tog 3 1         &kp N6  &kp N7  &kp N8    &kp N9    &kp N0    &kp MINUS
&caps_word   &kp SQT    &kp COMMA  &kp DOT   &kp P      &kp Y   &kp INSERT                                                      &kp PRINTSCREEN     &kp F   &kp G   &kp C     &kp R     &kp L     &kp FSLH
&kp TAB      &kp A      &kp O      &kp E     &kp U      &kp I   &kp PAUSE_BREAK  &kp LCTRL  &kp LALT      &kp LALT   &kp RCTRL  &kp K_CONTEXT_MENU  &kp D   &kp H   &kp T     &kp N     &kp S     &kp BSLH
&kp LSHFT    &kp SEMI   &kp Q      &kp J     &kp K      &kp X                               &kp HOME      &kp PG_UP                                 &kp B   &kp M   &kp W     &kp V     &kp Z     &kp RSHFT
&mo_tog 2 2  &kp GRAVE  &kp CAPS   &kp LEFT  &kp RIGHT          &kp BSPC         &kp DEL    &kp END       &kp ESC    &kp ENTER  &kp SPACE                   &kp UP  &kp DOWN  &kp LBKT  &kp RBKT  &mo_tog 2 2
            >;
        };

        macOS {
            display-name = "macos";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                               &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                               &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LGUI  &kp LALT      &kp LCTRL  &kp RGUI  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans        &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&mo 2   &trans  &trans  &trans  &trans          &trans  &trans    &trans        &trans     &trans    &trans          &trans  &trans  &trans  &trans  &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3   &kp F4   &kp F5   &kp F6  &tog 1                                                &mo 3   &kp F7  &kp F8   &kp F9   &kp F10  &kp F11  &kp F12
&trans  &trans  &kp F10  &kp F11  &kp F12  &trans  &none                                                 &none   &trans  &kp F10  &kp F11  &kp F12  &trans   &trans
&trans  &trans  &kp F7   &kp F8   &kp F9   &trans  &none     &trans      &trans       &trans     &trans  &none   &trans  &kp F7   &kp F8   &kp F9   &trans   &trans
&trans  &trans  &kp F4   &kp F5   &kp F6   &trans                        &email2      &trans                     &trans  &kp F4   &kp F5   &kp F6   &trans   &trans
&mo 2   &trans  &kp F1   &kp F2   &kp F3           &seasame  &username1  &email1      &kp PG_DN  &trans  &trans          &kp F1   &kp F2   &kp F3   &trans   &mo 2
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2          &bt BT_SEL 3          &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none                 &none                 &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none                 &none                 &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none                 &macro_ver            &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC                &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
